import java.util.Scanner;
class values {
    public static void main(String[] args) {
      
        int last,rev=0;
           System.out.println("value of n:");
           Scanner s= new Scanner(System.in);
           int n=s.nextInt();
              System.out.println(" N before swapping:"+n);
              while(n>0)
              {
                  last=n%10;
                  rev=rev*10+last;
                  n=n/10;
                  
              }
       
        
       
        System.out.println("After Reversing:"+rev);

        
       
      
    }
}
