import java.util.Scanner;

class Reversal {
    public static void main(String[] args) {
        
        String n = "college";
        
        System.out.println("N before reversing: " + n);
        
        String rev = ""; 
        
        
        for (int i = n.length() - 1; i >= 0; i--) {
            rev = rev + n.charAt(i); 
        }
        
        System.out.println("After Reversing: " + rev);
    }
}
