\\ swapping with one op
public class values {
    public static void main(String[] args) {
      
        int x,y;
        x=5;
        y=10;
         System.out.println("before swapping");
          System.out.println("x="+x+"y="+y);
        x=x^y;
        y=x^y;
        x=x^y;
        
        
       
        System.out.println("before swapping");
      System.out.println("x="+x+"y="+y);
        
       
      
    }
}


