public class values {
    public static void main(String[] args) {
        int n = 1221;
        int original = n;
        int rev = 0;
        int last;

  
        while (n > 0) {
            last = n % 10;
            rev = rev * 10 + last;
            n = n / 10;
        }

       
        if (original == rev) {
            System.out.println(original + " is a Palindrome.");
        } else {
            System.out.println(original + " is not a Palindrome.");
        }
    }
}
